meta {
  name: Send Message
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/battles/:battle_id/message
  body: json
  auth: bearer
}

params:path {
  battle_id: {{battleId}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "message": "Tell me about your deepest secret."
  }
}
