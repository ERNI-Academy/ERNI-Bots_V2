meta {
  name: Create Fortress
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/fortresses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "My Fortress",
    "story": "A fortress built on lies and riddles.",
    "protocol_id": "protocolo-autoverificador",
    "archetype_id": "arch-logico",
    "personality": "Sarcastic and evasive",
    "constraint_ids": ["0c6b5d6c-b6d5-4971-9a61-db5397179c25", "d8fb6bc5-aafe-465a-a1f0-12424e58d557"],
    "protected_word": "SHADOWKEY"
  }
}
