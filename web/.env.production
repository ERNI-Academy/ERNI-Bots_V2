# URL del backend Flask en producción (Azure App Service)
# En local se sobreescribe con .env.local → API_URL=http://localhost:5000
API_URL=https://ernibots-v2-api.azurewebsites.net

# Secret del admin — debe coincidir con ADMIN_SECRET del backend Flask
# En producción configurar como variable de entorno en Azure App Service, no aquí
ADMIN_SECRET=
